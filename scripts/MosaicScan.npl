/*
MosaicScan V1.0

Scans the head camera over a work plate target (e.g. an array/chip) in a
row-by-row grid, saving one still image per grid position ("tile"), so the
tiles can be stitched into one large overview image afterwards, e.g. with
Fiji/ImageJ:

    Plugins > Stitching > Grid/Collection Stitching...
    Type:              "Filename defined position"
    Grid size X:       <printed by this program at the end>
    Grid size Y:       <printed by this program at the end>
    Tile overlap:      <the % you entered below>
    First file index x: 1
    First file index y: 1
    File names for tiles: tile_r{yy}_c{xx}.bmp
    Directory:         the report/Mosaic_<scan name> folder this program prints

    Row/column numbers in the saved filenames start at 1 (tile_r01_c01.bmp,
    ...), matching Fiji's own default "First file index" of 1 above -- if
    that field has been changed from its default in your Fiji install,
    change it back to 1 (or update it to match whatever this program
    actually wrote to the folder).

How it works:
  1. The target you want to scan (e.g. your 6x4 mm array) must already be
     registered on the work plate (System - Work Plate...) with its correct
     X/Y position and DimX/DimY size -- the program reads those
     automatically via GetObjId/GetObjValue, so there is no need
     to manually jog to a start position first.
  2. Enter the target's exact name (as shown in the Work Plate window), the
     camera's current field of view (X only -- Y is computed from the fixed
     camera aspect ratio), the desired tile overlap, optional X/Y border
     offsets from the target's edges, and a name for this scan.
  3. The program computes a grid that fully covers the target, centered on
     it, creates report/Mosaic_<scan name>/, and steps through the grid in
     a snake pattern (left-right, then right-left on the next row, etc.) to
     minimize travel, saving one .bmp per position.

Notes:
  - The field of view is NOT read automatically -- it depends on the
    camera's current zoom/focus, which this repo has no scripted access to
    (CamViewConfig's scaling value lives in a separate, compiled tool, and
    isn't written to NPC16.INI or exposed via any documented NPL function).
    DEFAULT_FOV_X below pre-fills the setup dialog (height is computed from
    it via the camera's fixed aspect ratio) so you don't have to retype it
    every run, but it's still just the last value someone measured --
    re-measure with CamViewConfig's [Scaling] tool (manual Ch. 10.3)
    whenever the zoom/focus changes, update that one constant, and double
    check the value in the dialog before confirming.
  - Border offset X/Y (mm) grows or shrinks the scanned area relative to the
    target's registered size, applied evenly on both sides of that axis and
    centered on the target: positive values scan a larger area than the
    target, negative values scan a smaller area, 0 scans exactly the
    target's own size on that axis.
  - This program only takes pictures. It never dispenses anything and never
    lowers Z beyond the retracted position.
  - If a folder with the same scan name already exists, its files may be
    overwritten -- pick a fresh scan name for each run if you want to keep
    old tiles.
  - The setup dialog remembers the values from your last run, saved to
    Data/MosaicScan.set (created automatically -- delete it to reset
    everything back to the built-in defaults below).
*/

program MosaicScan;

#include "../Lib/GrabberTools.inc"

const DEFAULT_VIDEO_SOURCE = EXTERN;   // change to HEADCAMERA if this is wrong for your camera

// Default field-of-view WIDTH, pre-filled into the setup dialog below
// (still editable per run). The default HEIGHT is derived from this one
// number in Setup(), scaled by this system's fixed camera aspect ratio
// (see CAMERA_ASPECT_X/Y below) -- so there is only one measured value to
// keep in sync. Re-measure with CamViewConfig's [Scaling] tool (manual Ch.
// 10.3) whenever the zoom/focus changes, and update this one constant.
const DEFAULT_FOV_X = 1.5;    // mm

// This system's camera frame is 768x576 (PAL, "Video Format: UYVY
// 768x576" -- NP2_2015_3_software, Ch. 3 camera setup) = 4:3. Change these
// two if the camera/video format is ever reconfigured.
const CAMERA_ASPECT_X = 768.0;
const CAMERA_ASPECT_Y = 576.0;

type MosaicParameters = record
    targetName:    string;
    fovX:          real;
    fovY:          real;
    overlap:       real;
    borderOffsetX: real;
    borderOffsetY: real;
    scanName:      string;
    settleDelay:   real;
end;

var params:       MosaicParameters;
var reportFolder: string;

var targetId: integer;
var cx, cy, w, h, scanW, scanH: real;
var stepX, stepY: real;
var nCols, nRows: integer;
var startX, startY: real;
var row, colIndex, col: integer;
var x, y: real;
var leftToRight: boolean;
var filename: string;
var tileNum: integer;
var execResult: integer;


function Setup(): MosaicParameters;

var p, default: MosaicParameters;
var ok: boolean;
var settingsFName, line, lineContent: string;
var settingFile: file;
var posEqual: integer;
var lineReal: real;

begin

    default.targetName    = "CHIPS";
    default.fovX          = DEFAULT_FOV_X;
    default.fovY          = DEFAULT_FOV_X * CAMERA_ASPECT_Y / CAMERA_ASPECT_X;
    default.overlap       = 12.0;
    default.borderOffsetX = 0.0;
    default.borderOffsetY = 0.0;
    default.scanName      = "Scan1";
    default.settleDelay   = 0.3;

    p = default;
    settingsFName = "Data/MosaicScan.set";

    // Load the last-used values, if any, so the dialog below starts out
    // pre-filled with them instead of always resetting to the defaults
    // above. Any key that's missing or fails its range check falls back to
    // the default already in p, same as a first-ever run.
    settingFile = OpenR(filename = settingsFName);

    if FileState(settingFile) <> -1 then begin

        while FileState(settingFile) > 0 do begin

            line = Getln(f = settingFile);
            posEqual = FindString(sToSearch = line, sToFind = "=");

            if posEqual <> -1 then begin

                lineContent = Substring(s = line, iBeg = 0, iEnd = posEqual);

                if ToUpper(lineContent) == "TARGETNAME" then begin
                    p.targetName = Substring(line, posEqual + 1, -1);
                end;
                else
                if ToUpper(lineContent) == "FOVX" then begin
                    lineReal = StringToReal(s = Substring(line, posEqual + 1, -1));
                    if lineReal > 0.0 then p.fovX = lineReal;
                end;
                else
                if ToUpper(lineContent) == "OVERLAP" then begin
                    lineReal = StringToReal(s = Substring(line, posEqual + 1, -1));
                    if (lineReal >= 0.0) and (lineReal < 90.0) then p.overlap = lineReal;
                end;
                else
                if ToUpper(lineContent) == "BORDEROFFSETX" then begin
                    p.borderOffsetX = StringToReal(s = Substring(line, posEqual + 1, -1));
                end;
                else
                if ToUpper(lineContent) == "BORDEROFFSETY" then begin
                    p.borderOffsetY = StringToReal(s = Substring(line, posEqual + 1, -1));
                end;
                else
                if ToUpper(lineContent) == "SCANNAME" then begin
                    p.scanName = Substring(line, posEqual + 1, -1);
                end;
                else
                if ToUpper(lineContent) == "SETTLEDELAY" then begin
                    lineReal = StringToReal(s = Substring(line, posEqual + 1, -1));
                    if (lineReal >= 0.0) and (lineReal <= 10.0) then p.settleDelay = lineReal;
                end;

            end;    // if posEqual

        end;    // while

        Close(settingFile);

    end;    // if FileState

    ok = false;

    while not ok do begin

        Window("Mosaic scan setup",
               "Work plate target name to scan:", p.targetName,
               "Camera field of view, X (mm):", p.fovX,
               "Tile overlap (%):", p.overlap,
               "Border offset from target edges, X (mm, + = larger, - = smaller):", p.borderOffsetX,
               "Border offset from target edges, Y (mm, + = larger, - = smaller):", p.borderOffsetY,
               "Name for this scan (used for the output folder):", p.scanName,
               "Settle delay after each move (s):", p.settleDelay);

        p.fovY = p.fovX * CAMERA_ASPECT_Y / CAMERA_ASPECT_X;    // not editable -- derived from X

        ok = true;

        if p.fovX <= 0.0 then begin

            Message("Error", "Field of view must be greater than 0 mm.");
            ok = false;

        end;
        else if (p.overlap < 0.0) or (p.overlap >= 90.0) then begin

            Message("Error", "Overlap must be between 0 and 90 %.");
            ok = false;

        end;
        else if (p.settleDelay < 0.0) or (p.settleDelay > 10.0) then begin

            Message("Error", "Settle delay must be between 0 and 10 s.");
            ok = false;

        end;

    end;    // while

    // Save the now-validated values so the next run starts from here.
    settingFile = OpenRW(filename = settingsFName);

    if FileState(settingFile) <> -1 then begin

        Putln(f = settingFile, s = StringOf("targetName=", p.targetName));
        Putln(f = settingFile, s = StringOf("fovX=", p.fovX));
        Putln(f = settingFile, s = StringOf("overlap=", p.overlap));
        Putln(f = settingFile, s = StringOf("borderOffsetX=", p.borderOffsetX));
        Putln(f = settingFile, s = StringOf("borderOffsetY=", p.borderOffsetY));
        Putln(f = settingFile, s = StringOf("scanName=", p.scanName));
        Putln(f = settingFile, s = StringOf("settleDelay=", p.settleDelay));

        Close(settingFile);

    end;    // if FileState

    Setup = p;

end;


// Zero-pads 0..99 to two digits as a string ("0".."9" -> "00".."09").
function Pad2(n: integer): string;

begin

    if n < 10 then
        Pad2 = StringOf("0", n);
    else
        Pad2 = StringOf(n);

end;


// Smallest number of tiles, spaced "step" apart, needed to fully cover a
// span of "size" mm with tiles that are each "fov" mm wide -- centered.
function TileCount(size: real, fov: real, spacing: real): integer;

var need: real;
var n: integer;

begin

    if size <= fov then begin

        TileCount = 1;

    end;
    else begin

        need = (size - fov) / spacing;
        n = Int(need);
        if n < need then n = n + 1;    // round up
        TileCount = n + 1;

    end;

end;


begin

    params = Setup();

    if Confirmation("MosaicScan",
                     StringOf("Scan target '", params.targetName, "' now?\n",
                               "Field of view: ", params.fovX:0:2, " x ", params.fovY:0:2, " mm\n",
                               "Overlap: ", params.overlap:0:1, " %")) then begin

        targetId = GetObjId(name = params.targetName);

        if targetId = 0 then begin

            Message("Error", "Target '", params.targetName, "' was not found on the work plate.\n",
                    "Check spelling against the Work Plate window and try again.");

        end;
        else begin

            w = GetObjValue(object = targetId, valueIndex = 1);    // target width  (X)
            h = GetObjValue(object = targetId, valueIndex = 2);    // target height (Y)
            cx = GetObjValue(object = targetId, valueIndex = 4) + w / 2.0;    // target center X
            cy = GetObjValue(object = targetId, valueIndex = 5) + h / 2.0;    // target center Y

            // Offset applied evenly on both sides of each axis, so the scan
            // stays centered on cx/cy regardless of sign.
            scanW = w + 2.0 * params.borderOffsetX;
            scanH = h + 2.0 * params.borderOffsetY;

            if (scanW <= 0.0) or (scanH <= 0.0) then begin

                Message("Error", "Border offset (X=", params.borderOffsetX:0:2, ", Y=", params.borderOffsetY:0:2, ") mm is too negative for this target.\n",
                        "Target size: ", w:0:2, " x ", h:0:2, " mm -- offset would shrink the scan area to zero or less.");

            end;
            else begin

                stepX = params.fovX * (1.0 - params.overlap / 100.0);
                stepY = params.fovY * (1.0 - params.overlap / 100.0);

                nCols = TileCount(scanW, params.fovX, stepX);
                nRows = TileCount(scanH, params.fovY, stepY);

                startX = cx - ((nCols - 1) * stepX) / 2.0;
                startY = cy - ((nRows - 1) * stepY) / 2.0;

                reportFolder = StringOf("report/Mosaic_", params.scanName);
                execResult = Exec(command = StringOf("cmd.exe /c mkdir \"", reportFolder, "\""), wait = 1);

                if ShowGrabWindow() then begin

                    SetVideoSource(DEFAULT_VIDEO_SOURCE);
                    SetLiveVideo(on = true);
                    PositionAbsoluteZ(z = 0.0);    // retract before any XY sweep

                    Progress(mode = 1, title = "MosaicScan", value = 1);
                    tileNum = 0;
                    leftToRight = true;

                    for row = 0 to nRows - 1 do begin

                        y = startY + row * stepY;

                        for colIndex = 0 to nCols - 1 do begin

                            if leftToRight then begin
                                col = colIndex;
                            end;
                            else begin
                                col = nCols - 1 - colIndex;
                            end;

                            x = startX + col * stepX;

                            PositionAbsoluteXY(-1, x, y);
                            TimerDelay(t = params.settleDelay);
                            SetLiveVideo(on = false);

                            // +1: filenames are 1-based to match Fiji's
                            // default "First file index" of 1 (see header).
                            filename = StringOf(reportFolder, "/tile_r", Pad2(row + 1), "_c", Pad2(col + 1), ".bmp");
                            SaveBitmap(filename);

                            SetLiveVideo(on = true);

                            tileNum = tileNum + 1;
                            Progress(mode = 3, title = StringOf("Tile ", tileNum, " / ", nRows * nCols),
                                     value = tileNum, min = 0, max = nRows * nCols);

                        end;    // colIndex

                        leftToRight = not leftToRight;

                    end;    // row

                    Progress(mode = -1, title = "", value = 0);

                    HideGrabWindow();

                    Message("MosaicScan finished",
                            StringOf(nRows * nCols, " tiles saved to ", reportFolder, "\\.\n\n",
                                      "Fiji Grid/Collection Stitching settings:\n",
                                      "  Grid size X: ", nCols, "\n",
                                      "  Grid size Y: ", nRows, "\n",
                                      "  Tile overlap: ", params.overlap:0:1, " %\n",
                                      "  First file index x/y: 1\n",
                                      "  File names:   tile_r{yy}_c{xx}.bmp"));

                end;
                else begin

                    Message("Error", "Framegrabber is not installed / could not be opened.");

                end;    // if ShowGrabWindow

            end;    // if scanW/scanH valid

        end;    // if targetId

    end;    // if Confirmation

end.

