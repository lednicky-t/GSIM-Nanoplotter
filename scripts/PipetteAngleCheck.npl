/**
PipetteAngleCheck

Purpose: measure how a tip's pipette-to-camera XY position, as read back via
the native GetTipX(tip)/GetTipY(tip) calls after each CalibratePipettes()
call, depends on the commanded Z-gap (distance above the live-measured WSP
surface). If a tip is physically tilted rather than perfectly vertical, its
XY position will drift roughly linearly with Z (see lateral = deltaZ *
tan(angle)); fitting a line through x-vs-Z and y-vs-Z recovers that angle
directly. This automates, in one script, the manual Z-sweep procedure
documented in WSPCheck_TipCheck_Calibration_Notes.md, section 9 -- that
investigation found real per-axis slopes around 0.02-0.11 mm/mm (equivalent
angle a few degrees), so this is not a hypothetical effect on this
instrument.

Target WSP on workplate required (same as WSPCheck/TipCheck) and you need to
know its Z has been measured at least once ("Work Plate -> Measure
Z-Levels...").

How it works:
  1. Reads the live WSP surface Z once (GetZ), same as WSPCheck/TipCheck.
  2. For each Z-gap in Z_GAP_START..Z_GAP_END (step Z_GAP_STEP), repeats
     CalibratePipettes() REPEATS_PER_HEIGHT times at that height. Repeats
     are not independent measurements -- CalibratePipettes nudges the
     existing correction table towards the true value each call (a closed
     loop), so only the LAST repeat at each height is used as that height's
     data point, on the assumption it is the most converged. Every repeat is
     still logged, so you can check convergence yourself afterwards -- if
     the values are still moving a lot between repeat 2 and 3, increase
     REPEATS_PER_HEIGHT (the calibration notes needed >5 repeats in one
     session to see it settle).
  3. After the sweep, for each enabled tip with enough points, fits a
     straight line to x vs Z and to y vs Z (least squares) and reports the
     slope as an equivalent tilt angle via ArcTan(slope).
  4. Writes two CSV files under report/PipetteAngleCheck_<run name>/ :
     raw.csv (every gap/repeat/tip point) and fit.csv (the per-tip fit
     summary) -- for a proper analysis (weighted fit, uncertainty, plots)
     in Excel/Python afterwards, rather than trusting only the on-screen
     ArcTan number.

Assumptions carried over unchanged from WSPCheck/TipCheck, not re-verified
here: CalibratePipettes()'s own accuracy/behavior. tip_list is set to [1]
(tip 1 only) at the CalibratePipettes(...) call below -- that is the only
tip with a nonzero correction on this rig per the calibration notes; edit
that line (marked TIP_LIST_EDIT_HERE) to broaden it to other tips or [] for
"all enabled tips".

History -- why this reads GetTipX/GetTipY and not NPC16.INI: the first two
versions of this script read the pipette-to-camera correction back from
NPC16.INI's [Head] correctionX<tip>/correctionY<tip> keys (the value
CalibratePipettes() itself is documented to update). That requires opening
NPC16.INI with plain file I/O (OpenR) while the very same NanoPlotter engine
that has it open is running this script. On this rig that read reliably
failed on every single point across two full runs (2026-08-21) -- not an
intermittent glitch, the engine holds the file locked in a way that blocks
a second read every time. So this version reads tip position purely through
GetTipX(tip)/GetTipY(tip) instead: real, documented-signature-only (no
prose anywhere in the manual) native functions, not file I/O, unaffected by
that lock. The only real usage found in this repo
(Prog/TSMP/TransferSim_SpottingSOF_08C11.inc, CalculateRefTipPosition)
computes GetTipX(curTip) - GetTipX(refTip) as a tip-to-tip offset used to
predict where a spot should land -- which only makes sense if GetTipX/Y
already reflect whatever the alignment table has corrected that tip to, not
a fixed uncorrected geometric constant. That is inferred from one usage
site, not documented, and this script was never able to get a single
successful NPC16.INI reading on this rig to compare it against -- treat the
resulting angle as provisional on that basis, not as fully cross-validated
against the established method. (An earlier version logged both sources
side by side for exactly that comparison; removed here since the INI half
never produced one usable point to compare.)

Copyright notes as in WSPCheck.npl/TipCheck.npl: pattern based on GeSiM's
own sample programs.
**/

program PipetteAngleCheck;

//  Change the next line if your target has a different name than WSP1:
const WATER_SENSITIVE_PAPER = WSP1;

//  Which tips to run CalibratePipettes() on: edit the "tip_list = [1]"
//  argument in the CalibratePipettes(...) call further down (search for
//  TIP_LIST_EDIT_HERE). [1] = tip 1 only (this rig's only actively-used tip
//  per the calibration notes); [] = all enabled tips; [1,2,5] for a subset.
//  (Kept as an inline literal at the call site, not a named const, because
//  every existing script in this repo only ever uses the "[...]" tip-list
//  syntax inline -- there is no working example of assigning it to a const
//  first, so this does not risk relying on untested syntax.)

//  Z-gap sweep, mm above the live-measured WSP surface. NUM_GAPS must match
//  how many steps Z_GAP_START..Z_GAP_END/Z_GAP_STEP actually produces --
//  it is not computed automatically, so keep it in sync if you change the
//  three values above it.
const Z_GAP_START = 0.3;
const Z_GAP_STEP   = 0.1;
const NUM_GAPS      = 8;    // 0.3, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9, 1.0

const REPEATS_PER_HEIGHT = 3;
const DROPLETS = 1;     // manual's own "smallest possible value" advice, matches section 8 of the notes
const DRY_DELAY = 5.0;  // seconds, matches WSPCheck's default

const NUM_TIPS = 16;

#include "../Lib/GrabberTools.inc"


function Abs(value: real): real;

begin

    if value < 0 then
        Abs = -value;
    else
        Abs = value;

end;


type real_array = array[1..NUM_GAPS] of real;

type fit_result = record

    valid: boolean;
    slope: real;
    intercept: real;
    r2: real;

end;


//  Least-squares fit of ys = slope*xs + intercept over the first n entries
//  of xs/ys. valid = false if n is too small or all xs are identical
//  (a vertical/undefined fit).
function LinearFit(n: integer, xs: real_array, ys: real_array): fit_result;

var i: integer;
var sx, sy, sxx, sxy, meanX, meanY, denom, ssTot, ssRes, yPred: real;
var result: fit_result;

begin

    result.valid = false;
    result.slope = 0.0;
    result.intercept = 0.0;
    result.r2 = 0.0;

    if n >= 2 then begin

        sx = 0.0; sy = 0.0; sxx = 0.0; sxy = 0.0;

        for i = 1 to n do begin

            sx = sx + xs[i];
            sy = sy + ys[i];
            sxx = sxx + xs[i]*xs[i];
            sxy = sxy + xs[i]*ys[i];

        end;

        denom = n*sxx - sx*sx;

        if Abs(denom) > 0.0000001 then begin

            meanX = sx / n;
            meanY = sy / n;

            result.slope = (n*sxy - sx*sy) / denom;
            result.intercept = meanY - result.slope * meanX;

            ssTot = 0.0; ssRes = 0.0;

            for i = 1 to n do begin

                ssTot = ssTot + (ys[i]-meanY)*(ys[i]-meanY);
                yPred = result.slope*xs[i] + result.intercept;
                ssRes = ssRes + (ys[i]-yPred)*(ys[i]-yPred);

            end;

            if ssTot > 0.0 then
                result.r2 = 1.0 - ssRes/ssTot;
            else
                result.r2 = 1.0;

            result.valid = true;

        end;    // if denom

    end;    // if n >= 2

    LinearFit = result;

end;


type tip_data = record

    count: integer;
    zVals: real_array;
    xVals: real_array;
    yVals: real_array;

end;


var tipData: array[1..NUM_TIPS] of tip_data;
var wspSurfaceZ: real;
var gapIndex, repeatIndex, tip: integer;
var gap, zDispense: real;
var tipPosX, tipPosY: real;
var scanName: string;
var reportFolder: string;
var execResult: integer;
var rawFile, fitFile: file;
var piVal, angleX, angleY, angleTotal: real;
var fitX, fitY: fit_result;
var runOk: boolean;


begin

    scanName = "run1";

    Window("Pipette Angle Check setup",
           "Name for this run (used for the output folder):", scanName);

    piVal = 4.0 * ArcTan(1.0);

    if ShowGrabWindow() then begin

        ClearGrabWindow();
        Writeln("");
        Writeln(Date(), " ", Time());
        Writeln("PipetteAngleCheck starting, run name = ", scanName);

        wspSurfaceZ = GetZ(WATER_SENSITIVE_PAPER);

        if wspSurfaceZ < 0 then begin

            Message("Error", "You must measure the z level of the water sensitive paper first!");
            HideGrabWindow();
            exit;

        end;

        Writeln("Live GetZ(WSP) = ", wspSurfaceZ:0:3, " mm");

        // Kept short -- NPL strings are capped at 256 chars (see MosaicScan.npl).
        runOk = Confirmation("Pipette Angle Check",
            StringOf("Run ", NUM_GAPS*REPEATS_PER_HEIGHT, " calibrations (", NUM_GAPS,
                      " heights x ", REPEATS_PER_HEIGHT, " repeats), Z-gap ", Z_GAP_START:0:2,
                      "-", (Z_GAP_START+(NUM_GAPS-1)*Z_GAP_STEP):0:2, " mm, step ", Z_GAP_STEP:0:2,
                      " mm, ", DROPLETS, " droplet(s), ", DRY_DELAY:0:1, " s dry time.\n",
                      "Uses WSP paper, takes a while. Continue?"));

        if runOk then begin

            for tip = 1 to NUM_TIPS do begin

                tipData[tip].count = 0;

            end;

            reportFolder = StringOf("report/PipetteAngleCheck_", scanName);
            execResult = Exec(command = StringOf("cmd.exe /c mkdir \"", reportFolder, "\""), wait = 1);

            rawFile = OpenRW(filename = StringOf(reportFolder, "/raw.csv"));

            if FileState(rawFile) > 0 then
                Putln(f = rawFile, s = "gap_mm,repeat,tip,gettipx_mm,gettipy_mm");

            SetHeadCamLight(0, true);

            for gapIndex = 0 to NUM_GAPS - 1 do begin

                gap = Z_GAP_START + gapIndex * Z_GAP_STEP;
                zDispense = wspSurfaceZ - gap;

                Writeln("");
                Writeln("--- Z-gap = ", gap:0:2, " mm, absolute dispense Z = ", zDispense:0:3, " mm ---");

                for repeatIndex = 1 to REPEATS_PER_HEIGHT do begin

                    SetHeadCamLight(0, true);

                    // TIP_LIST_EDIT_HERE
                    if CalibratePipettes(tip_list = [1], tar_paper = WATER_SENSITIVE_PAPER,
                                          z_dispense = zDispense, droplets = DROPLETS, DRY_DELAY) then begin

                        for tip = 1 to NUM_TIPS do begin

                            if GetSystemValue(infoIndex = 1, partIndex = tip, partInfoIndex = 4) > 0 then begin

                                tipPosX = GetTipX(tip);
                                tipPosY = GetTipY(tip);

                                Writeln("  gap=", gap:0:2, " repeat=", repeatIndex, " tip=", tip,
                                        "  GetTipX=", tipPosX:0:4, "  GetTipY=", tipPosY:0:4);

                                //  Every repeat is logged here (not just the last one at each height) so
                                //  convergence can be checked afterwards, per the header comment.
                                if FileState(rawFile) > 0 then
                                    Putln(f = rawFile, s = StringOf(gap:0:2, ",", repeatIndex, ",", tip,
                                                                      ",", tipPosX:0:4, ",", tipPosY:0:4));

                                if repeatIndex = REPEATS_PER_HEIGHT then begin

                                    tipData[tip].count = tipData[tip].count + 1;
                                    tipData[tip].zVals[tipData[tip].count] = gap;
                                    tipData[tip].xVals[tipData[tip].count] = tipPosX;
                                    tipData[tip].yVals[tipData[tip].count] = tipPosY;

                                end;    // last repeat at this height

                            end;    // tip enabled

                        end;    // for tip

                    end;    // if CalibratePipettes
                    else begin

                        Writeln("  CalibratePipettes reported a failure at gap=", gap:0:2,
                                " repeat=", repeatIndex, " -- point skipped.");

                    end;    // else

                end;    // for repeatIndex

            end;    // for gapIndex

            if FileState(rawFile) > 0 then Close(rawFile);

            //  Fit and report.
            fitFile = OpenRW(filename = StringOf(reportFolder, "/fit.csv"));

            if FileState(fitFile) > 0 then
                Putln(f = fitFile, s = "tip,n,slope_x,intercept_x,r2_x,angle_x_deg,slope_y,intercept_y,r2_y,angle_y_deg,angle_total_deg");

            Writeln("");
            Writeln("=== Fit results (GetTipX/GetTipY vs Z-gap, per tip) ===");

            for tip = 1 to NUM_TIPS do begin

                if tipData[tip].count >= 2 then begin

                    fitX = LinearFit(tipData[tip].count, tipData[tip].zVals, tipData[tip].xVals);
                    fitY = LinearFit(tipData[tip].count, tipData[tip].zVals, tipData[tip].yVals);

                    Writeln("Tip ", tip, " (n=", tipData[tip].count, "):");

                    if fitX.valid and fitY.valid then begin

                        angleX = ArcTan(fitX.slope) * 180.0 / piVal;
                        angleY = ArcTan(fitY.slope) * 180.0 / piVal;
                        angleTotal = ArcTan(Sqrt(fitX.slope*fitX.slope + fitY.slope*fitY.slope)) * 180.0 / piVal;

                        Writeln("  dx/dZ slope = ", fitX.slope:0:4, " (R2=", fitX.r2:0:3, ") -> angle_x = ", angleX:0:2, " deg");
                        Writeln("  dy/dZ slope = ", fitY.slope:0:4, " (R2=", fitY.r2:0:3, ") -> angle_y = ", angleY:0:2, " deg");
                        Writeln("  combined tilt = ", angleTotal:0:2, " deg");

                    end;    // if valid
                    else begin

                        angleX = 0.0; angleY = 0.0; angleTotal = 0.0;
                        Writeln("  fit not possible (all Z-gaps identical or too few points).");

                    end;

                    if FileState(fitFile) > 0 then
                        Putln(f = fitFile, s = StringOf(tip, ",", tipData[tip].count, ",",
                            fitX.slope:0:5, ",", fitX.intercept:0:5, ",", fitX.r2:0:4, ",", angleX:0:3, ",",
                            fitY.slope:0:5, ",", fitY.intercept:0:5, ",", fitY.r2:0:4, ",", angleY:0:3, ",",
                            angleTotal:0:3));

                end;    // if count >= 2

            end;    // for tip

            if FileState(fitFile) > 0 then Close(fitFile);

            Message("Pipette Angle Check", "Sweep finished.\n",
                    "Raw data and fit results written to\n", reportFolder, "/\n",
                    "See the report window for a summary.");

            HideGrabWindow();

        end;    // if runOk
        else begin

            HideGrabWindow();

        end;

    end;    // if ShowGrabWindow
    else begin

        Message("Error", "Framegrabber is not installed.");

    end;

end.
